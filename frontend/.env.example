VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Solo para scripts locales (seed.mjs) — la cuenta de admin creada en Supabase Auth.
# Nunca se usa en el navegador/frontend, no lleva prefijo VITE_.
SEED_ADMIN_EMAIL=admin@ejemplo.com
SEED_ADMIN_PASSWORD=tu-contraseña

# Mercado Pago — la Public Key sí viaja al navegador (por eso lleva VITE_), el
# Access Token NUNCA debe tener prefijo VITE_. Se usa solo para subirlo como
# secreto de la Edge Function, no lo lee el frontend.
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx

# Qué pasarela online usa el checkout: payway o mercadopago. Tiene que estar
# incluida en el secreto ENABLED_PAYMENT_PROVIDERS de la Edge Function.
VITE_ONLINE_PAYMENT=payway

# Payway — la llave pública y el modo sandbox viajan al navegador (VITE_);
# la llave privada y el site id NUNCA: solo se suben como secretos de la
# Edge Function.
VITE_PAYWAY_SANDBOX=true
VITE_PAYWAY_PUBLIC_KEY=rYm7zBeSY0MdpJPQX2QMuSOl07Av1pK0
PAYWAY_SITE_ID=93145539
PAYWAY_PRIVATE_KEY=C1PmtjqW1ttDxWcb6PwYS13OrOeJo5dZ
