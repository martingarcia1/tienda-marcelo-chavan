# ── Supabase (público: la app lo usa en el navegador) ──────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Billeteras por local ───────────────────────────────────────────
# Las variables VITE_ son públicas (van al navegador). Las demás son
# SECRETAS: nunca llevan VITE_, no se suben a Vercel y solo se cargan como
# secretos de las Edge Functions (supabase secrets set ...).
# Qué billetera usa cada local se define en la tabla "locales" de la base
# (columna payment_provider); vacío = local a consulta por WhatsApp.

# I · Sede Central (Miguel Siufi) — solo vidriera, sin billetera.

# II · Peatonal Mendoza (Esteban Siufi)
VITE_MP_PUBLIC_KEY_PEATONAL_MENDOZA=
MP_ACCESS_TOKEN_PEATONAL_MENDOZA=
VITE_PAYWAY_PUBLIC_KEY_PEATONAL_MENDOZA=
PAYWAY_SITE_ID_PEATONAL_MENDOZA=
PAYWAY_PRIVATE_KEY_PEATONAL_MENDOZA=

# III · Galería Áncel 9 (Marcela Siufi)
# Mercado Pago: credenciales de PRODUCCIÓN de la cuenta real de Marcela.
VITE_MP_PUBLIC_KEY_GALERIA_ANCEL_9=
MP_ACCESS_TOKEN_GALERIA_ANCEL_9=
# Payway: credenciales de PRUEBA (sandbox) de Marcela — pendiente que Payway habilite el sitio.
VITE_PAYWAY_PUBLIC_KEY_GALERIA_ANCEL_9=
PAYWAY_SITE_ID_GALERIA_ANCEL_9=
PAYWAY_PRIVATE_KEY_GALERIA_ANCEL_9=

# Modo prueba de cada pasarela (true = sandbox)
VITE_PAYWAY_SANDBOX=true
MP_SANDBOX=false
